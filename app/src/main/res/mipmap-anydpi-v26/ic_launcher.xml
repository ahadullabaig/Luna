<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so every device that can install Luna supports adaptive icons and there
  is no need for a ladder of legacy mipmap PNGs. The monochrome layer is what Android 13
  themed icons tint.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/luna_deep_navy" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
